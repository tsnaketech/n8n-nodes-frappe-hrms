			"dist/credentials/FrappeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/FrappeHrms/FrappeHrms.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.42.0",
		"eslint": "9.39.5",
		"prettier": "3.9.6",
		"release-it": "21.0.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
