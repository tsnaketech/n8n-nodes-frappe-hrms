{
	"name": "n8n-nodes-frappe-hrms",
	"version": "0.1.0",
	"description": "n8n node for Frappe HR (HRMS): employees, leave, attendance, expense claims, salary slips and recruitment",
	"license": "MIT",
	"homepage": "https://github.com/tsnaketech/n8n-nodes-frappe-hrms#readme",
	"keywords": [
		"n8n-community-node-package",
		"frappe",
		"frappe-hr",
		"hrms",
		"erpnext",
		"hr"
	],
	"author": {
		"name": "tsnaketech",
		"email": "snaketech@proton.me",
		"url": "https://github.com/tsnaketech"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsnaketech/n8n-nodes-frappe-hrms.git"
	},
	"bugs": {
		"url": "https://github.com/tsnaketech/n8n-nodes-frappe-hrms/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
